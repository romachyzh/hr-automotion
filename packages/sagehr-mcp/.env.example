SAGEHR_SUBDOMAIN=acme
SAGEHR_API_KEY=your-api-key-from-sage-hr-settings-integrations

# Required only when starting with --http.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MCP_BEARER_TOKEN=generate-a-long-random-string

# Web dashboard (--http only). Set DASHBOARD_PASSWORD to enable the dashboard;
# leave it unset to run MCP-only. SESSION_SECRET is required whenever
# DASHBOARD_PASSWORD is set (it signs the session cookie).
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Optional: override where the built dashboard assets are served from.
# DASHBOARD_DIST_DIR=

# Optional
SAGEHR_USER_AGENT=hr-automotion/sagehr-mcp/0.1
LOG_LEVEL=info
HTTP_PORT=8787

