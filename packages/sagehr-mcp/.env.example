SAGEHR_SUBDOMAIN=acme
SAGEHR_API_KEY=your-api-key-from-sage-hr-settings-integrations

# Required only when starting with --http.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MCP_BEARER_TOKEN=generate-a-long-random-string

# Optional
SAGEHR_USER_AGENT=hr-automotion/sagehr-mcp/0.1
LOG_LEVEL=info
HTTP_PORT=8787

