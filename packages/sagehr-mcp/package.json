{
  "name": "@hr-automotion/sagehr-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing SageHR data to Claude and other MCP clients",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "sagehr-mcp": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:http": "tsx --env-file=.env src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hr-automotion/sagehr-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
